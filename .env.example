# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=our_galaxy
DB_USERNAME=our_galaxy
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
COUPLE_INVITATION_EXPIRE_HOURS=168
FILE_LOCAL_ROOT=./uploads
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_REQUEST_SIZE_BYTES=12582912

# Integration tests (use a separate database and Redis logical database)
TEST_DB_NAME=our_galaxy_test
TEST_REDIS_DATABASE=15
TEST_FILE_ROOT=./target/test-uploads

# Frontend
VITE_API_PROXY_TARGET=http://localhost:8080
